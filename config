exec --no-startup-id VBoxClient --clipboard
exec --no-startup-id polybar main
set $mod Mod4
font pango:Comic True Mono Regular 18
default_border none
default_floating_border none

for_window [class="Sublime_text" window_role="GtkFileChooserDialog"] floating enable, resize set 720 px 480 px, move position center, move left 300 px, move up 150 px

#for_window [class="(?i)zathura"] resize set width 48 ppt

#for_window [class="(?i)zathura"] exec --no-startup-id sh /home/t/.config/i3/zathura-resize.sh




bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% 
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% 
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle 
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle 

exec --no-startup-id xrdb -merge ~/.Xresources

bindsym $mod+d exec --no-startup-id rofi -config ~/.config/rofi/menu.rasi -show drun

bindsym Print exec --no-startup-id flameshot gui
floating_modifier $mod
#tiling_drag modifier titlebar
bindsym $mod+Return exec kitty
bindsym $mod+Shift+q kill

